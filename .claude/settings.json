{
  "permissions": {
    "allow": [
      "Read(//c/**/vid downloader/**)",
      "Bash(python -m pytest *)",
      "Bash(python -m ruff check *)",
      "Bash(python -m ruff format *)",
      "Bash(.venv/Scripts/python -m pytest *)",
      "Bash(ruff check *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(mv * /etc/*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(~/.ssh/*)"
    ],
    "additionalDirectories": [
      "c:\\Users\\etreq\\dev\\vid downloader\\docs"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import sys, json, re; inp=json.load(sys.stdin); path=inp.get('file_path',''); sys.exit(1 if re.search(r'(error_log|history_log|logfile)\\.txt$', path) else 0)\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python -m ruff check --fix \"$CLAUDE_TOOL_INPUT_PATH\" && python -m ruff format \"$CLAUDE_TOOL_INPUT_PATH\""
          }
        ]
      }
    ]
  }
}

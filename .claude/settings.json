{
  "permissions": {
    "allow": [
      "Read(//c/**/vid downloader/**)",
      "Bash(python -m pytest *)",
      "Bash(python -m ruff check *)",
      "Bash(python -m ruff format *)",
      "Bash(.venv/Scripts/python -m pytest *)",
      "Bash(ruff check *)",
      "Bash(grep -E \"\\\\.\\(py|pyw\\)$\")",
      "Bash(python -c \"from src.history_dialog import HistoryDialog; print\\('import OK'\\)\")",
      "Bash(python -c \"from PyQt6.QtWidgets import QMenu, QApplication; import sys; app = QApplication\\(sys.argv\\); m = QMenu\\(\\); a = m.addAction\\('test'\\); print\\(type\\(a\\)\\); print\\(a\\)\")",
      "Bash(python -c ' *)",
      "Bash(grep -r \"C:\\\\\\\\\\\\\\\\Users\\\\\\\\|etreq\" \"c:\\\\Users\\\\etreq\\\\dev\\\\vid downloader\" --include=\"*.py\")",
      "Bash(awk -F: '{sum+=$2} END {print \"Total test functions:\", sum}')",
      "Bash(uv sync *)",
      "Bash(awk '{print $1}')",
      "Read(//c/Users/etreq/.claude/**)",
      "mcp__plugin_github_github__list_commits",
      "mcp__plugin_github_github__list_pull_requests",
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(mv * /etc/*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(~/.ssh/*)"
    ],
    "additionalDirectories": [
      "c:\\Users\\etreq\\dev\\vid downloader\\docs"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import sys, json, re; inp=json.load(sys.stdin); path=inp.get('file_path',''); sys.exit(1 if re.search(r'(error_log|history_log|logfile)\\.txt$', path) else 0)\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python -m ruff check --fix \"$CLAUDE_TOOL_INPUT_PATH\" && python -m ruff format \"$CLAUDE_TOOL_INPUT_PATH\""
          }
        ]
      }
    ]
  }
}

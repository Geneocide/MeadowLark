# Required: where downloaded videos are saved
VID_DL_VIDEO_STORAGE_DIR=~/Videos

# Required: yt-dlp archive file (prevents re-downloading)
VID_DL_ARCHIVE_PATH=./resources/archive.txt

# Required: output dir for miscellaneous podcast downloads
VID_DL_PODCAST_MISC_OUTPUT_DIR=~/Music/Podcasts

# Optional: path to your own yt-dlp cookies file (do NOT share this — it contains your login sessions)
# VID_DL_COOKIES_FILE=resources/cookies.txt

# Optional overrides (defaults shown)
# VID_DL_ERROR_LOG=error_log.txt
# VID_DL_HISTORY_LOG=history_log.txt
# VID_DL_RESOURCES_DIR=resources
# VID_DL_VENV_SCRIPTS=.venv/Scripts
# VID_DL_HTTP_TIMEOUT=120
# VID_DL_SOCKET_TIMEOUT=120
# VID_DL_HTTP_REQUEST_TIMEOUT=5
# VID_DL_MAX_FRAGMENT_RETRIES=10
# VID_DL_PODCAST_MIN_DURATION_SECONDS=180
# VID_DL_SPONSORBLOCK_CACHE_TTL_HOURS=6
# VID_DL_LIVE_QUEUE_CHECK_INTERVAL_MINUTES=30
# VID_DL_PODCAST_LOOKAHEAD_MAX_ATTEMPTS=5
# VID_DL_MERGE_OUTPUT_FORMAT=mp4

# ========== PLAYLIST FILES ==========
# Optional: paths to your playlist files (defaults shown)
# VID_DL_PLAYLISTS_FILE=resources/playlists/playlists.txt
# VID_DL_PLAYLISTS_720_FILE=resources/playlists/720playlists.txt
# VID_DL_PLAYLISTS_AUDIO_FILE=resources/playlists/audio playlists.txt

# ========== MEDIA FORMATS ==========
# Optional: output formats (defaults shown)
# VID_DL_VIDEO_FORMAT=mp4        # Options: mp4, mkv, webm
# VID_DL_AUDIO_FORMAT=m4a         # Options: m4a, mp3, opus, flac, wav

# ========== PODCAST AUTOMATION ==========
# Optional: auto-check podcasts on schedule (default: true)
# VID_DL_PODCAST_AUTO_CHECK=true
# VID_DL_PODCAST_CHECK_INTERVAL_MINUTES=60  # Range: 5-1440

# ========== USER INTERFACE LABELS ==========
# Optional: customize button and drop zone display text (does NOT change behavior)
# VID_DL_LABEL_OUTPUT_FONT=Arial
# VID_DL_LABEL_OUTPUT_FONT_SIZE=16
# VID_DL_LABEL_READY_TEXT=[ Ready ]
# VID_DL_LABEL_DROP_1080=1080
# VID_DL_LABEL_DROP_720=720
# VID_DL_LABEL_DROP_AUDIO=audio
# VID_DL_LABEL_BTN_PLAYLISTS=Playlists
# VID_DL_LABEL_BTN_720=720 Playlists
# VID_DL_LABEL_BTN_PODCASTS=YT Podcasts

# ========== WINDOW BEHAVIOR ==========
# Optional: keep app window above all other windows (default: true)
# VID_DL_ALWAYS_ON_TOP=true

# ========== DEBUG/MIGRATION ==========
# Optional: enable logfile migration on startup (default: true)
# VID_DL_LOGFILE_MIGRATION=true

# Required: where downloaded videos are saved
VID_DL_VIDEO_STORAGE_DIR=~/Videos

# Required: yt-dlp archive file (prevents re-downloading)
VID_DL_ARCHIVE_PATH=./resources/archive.txt

# Required: output dir for miscellaneous podcast downloads
VID_DL_PODCAST_MISC_OUTPUT_DIR=~/Music/Podcasts

# Optional: path to your own yt-dlp cookies file (do NOT share this — it contains your login sessions)
# VID_DL_COOKIES_FILE=resources/cookies.txt

# Optional: YouTube player clients (comma-separated, priority order). Default is
# web_embedded, the client measured to serve complete files as of 2026-08. Its
# predecessor, tv_embedded, was dropped from yt-dlp's client registry.
# mweb produces media URLs with a valid pot= token that still 403 after ~1 MB
# (SABR enforcement, yt-dlp #12482); tv and the rest expose SABR-only formats and
# fail with "Requested format is not available". Adding mweb as a fallback is
# counterproductive: the first client supplying a format id wins, so it would
# take rungs web_embedded could serve. The PO-token provider is still required.
# VID_DL_YT_PLAYER_CLIENT=web_embedded

# Optional: override the bgutil PO-token provider server dir (script-deno mode).
# Defaults to the vendored vendor/bgutil-pot-provider/server (dev) or the bundled
# bgutil-server dir (frozen). Must contain src/generate_once.ts + node_modules
# (run scripts/setup_pot_provider.py), or 1080p downloads fail with HTTP 403.
# See the README PO-token setup section.
# VID_DL_POT_SERVER_HOME=

# Optional overrides (defaults shown)
# VID_DL_ERROR_LOG=error_log.txt
# VID_DL_HISTORY_LOG=history_log.txt
# VID_DL_RESOURCES_DIR=resources
# VID_DL_VENV_SCRIPTS=.venv/Scripts
# VID_DL_HTTP_TIMEOUT=120
# VID_DL_SOCKET_TIMEOUT=120
# VID_DL_HTTP_REQUEST_TIMEOUT=5
# VID_DL_MAX_FRAGMENT_RETRIES=10
# VID_DL_PODCAST_MIN_DURATION_SECONDS=180
# VID_DL_SPONSORBLOCK_CACHE_TTL_HOURS=6
# VID_DL_LIVE_QUEUE_CHECK_INTERVAL_MINUTES=30
# VID_DL_PODCAST_LOOKAHEAD_MAX_ATTEMPTS=5
# VID_DL_MERGE_OUTPUT_FORMAT=mp4

# ========== PLAYLIST FILES ==========
# Optional: paths to your playlist files (defaults shown). Also editable from the
# Settings dialog's Playlists tab, which now lists all six resolution rungs below,
# not just 1080/720.
# VID_DL_PLAYLISTS_FILE=resources/playlists/playlists.txt
# VID_DL_PLAYLISTS_720_FILE=resources/playlists/720playlists.txt
# VID_DL_PLAYLISTS_2160_FILE=resources/playlists/2160playlists.txt
# VID_DL_PLAYLISTS_1440_FILE=resources/playlists/1440playlists.txt
# VID_DL_PLAYLISTS_480_FILE=resources/playlists/480playlists.txt
# VID_DL_PLAYLISTS_360_FILE=resources/playlists/360playlists.txt
# VID_DL_PLAYLISTS_AUDIO_FILE=resources/playlists/audio playlists.txt

# ========== RESOLUTION PRESETS ==========
# Optional: comma-separated resolution rungs the app offers (default: 1080,720).
# Registered rungs: 2160, 1440, 1080, 720, 480, 360. Unknown/malformed entries are
# dropped; if nothing valid remains, the default pair is used. Editable from the
# Settings dialog's Resolutions tab (one checkbox per rung) -- hand-editing this
# value is no longer required. The main window's drop-target tiles for rungs other
# than 1080/720 ship in a later phase; enabling a rung here today only affects the
# Settings dialog's Playlists/Interface tabs and the retry-ladder descent order.
# VID_DL_ENABLED_RESOLUTIONS=1080,720

# ========== MEDIA FORMATS ==========
# Optional: output formats (defaults shown)
# VID_DL_VIDEO_FORMAT=mp4        # Options: mp4, mkv, webm
# VID_DL_AUDIO_FORMAT=m4a         # Options: m4a, mp3, opus, flac, wav

# ========== PODCAST AUTOMATION ==========
# Optional: auto-check podcasts on schedule (default: true)
# VID_DL_PODCAST_AUTO_CHECK=true
# VID_DL_PODCAST_CHECK_INTERVAL_MINUTES=60  # Range: 5-1440

# ========== USER INTERFACE LABELS ==========
# Optional: customize button and drop zone display text (does NOT change behavior).
# Also editable from the Settings dialog's Interface tab, which now lists all six
# resolution rungs below, not just 1080/720.
# VID_DL_LABEL_OUTPUT_FONT=Arial
# VID_DL_LABEL_OUTPUT_FONT_SIZE=16
# VID_DL_LABEL_READY_TEXT=[ Ready ]
# VID_DL_LABEL_DROP_1080=1080
# VID_DL_LABEL_DROP_720=720
# VID_DL_LABEL_DROP_2160=2160
# VID_DL_LABEL_DROP_1440=1440
# VID_DL_LABEL_DROP_480=480
# VID_DL_LABEL_DROP_360=360
# VID_DL_LABEL_DROP_AUDIO=audio
# VID_DL_LABEL_BTN_PLAYLISTS=Playlists
# VID_DL_LABEL_BTN_720=720 Playlists
# VID_DL_LABEL_BTN_2160=2160 Playlists
# VID_DL_LABEL_BTN_1440=1440 Playlists
# VID_DL_LABEL_BTN_480=480 Playlists
# VID_DL_LABEL_BTN_360=360 Playlists
# VID_DL_LABEL_BTN_PODCASTS=YT Podcasts

# ========== WINDOW BEHAVIOR ==========
# Optional: keep app window above all other windows (default: true)
# VID_DL_ALWAYS_ON_TOP=true

# ========== DEBUG/MIGRATION ==========
# Optional: enable logfile migration on startup (default: true)
# VID_DL_LOGFILE_MIGRATION=true

# Optional: capture yt-dlp's own verbose output to resources/ytdlp_debug.log
# (default: false). Turn this on to diagnose extraction or HTTP 403 failures --
# error_log.txt records only the final exception, not which player client served
# the format or whether its media URL carried a pot= token. The capture contains
# PO tokens and session identifiers, so do NOT share it; leave it off otherwise.
# VID_DL_YTDLP_VERBOSE=false
# VID_DL_YTDLP_DEBUG_LOG=resources/ytdlp_debug.log

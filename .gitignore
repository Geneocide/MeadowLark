# Ignore scripts/ contents (not the dir itself) so the one setup script below can be
# re-included -- a negation can't rescue a file whose parent dir is excluded outright.
scripts/*
# Track the PO-token provider setup script (dev checkout + Phase 3 CI both run it);
# the rest of scripts/ stays local-only.
!scripts/setup_pot_provider.py
docs/
vendor/bgutil-pot-provider/server/node_modules/
# Re-include the vendored lockfile that the global "*.lock" rule would exclude;
# `deno install --frozen` in scripts/setup_pot_provider.py needs it on a fresh checkout.
!vendor/bgutil-pot-provider/server/deno.lock